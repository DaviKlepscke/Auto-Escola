{
  "name": "auto-escola-gestao",
  "version": "1.0.0",
  "description": "Sistema Desktop de Gestão de Autoescola (CFC) - Electron, TypeScript, Bootstrap e MySQL",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "electron .",
    "dev": "tsc && electron .",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac"
  },
  "keywords": [
    "autoescola",
    "cfc",
    "electron",
    "typescript",
    "bootstrap",
    "mysql",
    "detran"
  ],
  "author": "Equipe Especialista",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "mysql2": "^3.11.5"
  }
}
